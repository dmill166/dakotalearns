# Purpose: Link patterns the weekly link check skips: sites that block
#   automated checkers (they answer bots with 403 or 999 even when the page
#   is fine), plus mail links. Check these by hand when you touch them.
^mailto:
^https?://(www\.)?linkedin\.com/
^https?://(www\.)?reddit\.com/
^https?://chat\.openai\.com/
# Verified alive by hand 2026-11-22 (Stack Exchange API, a browser fetch,
# or the site's home page); they answer automated checkers with 403.
^https?://([a-z]+\.)?stackoverflow\.com/
^https?://([a-z]+\.)?stackexchange\.com/
^https?://(www\.)?acm\.org/
^https?://(www\.)?bls\.gov/
^https?://(www\.)?forbes\.com/
^https?://(www\.)?indeed\.com/
^https?://(www\.)?udemy\.com/
^https?://(www\.)?skillshare\.com/
